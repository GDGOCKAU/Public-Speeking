{
  "name": "gdg-live-event",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:app": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --host 0.0.0.0",
    "seed": "node scripts/seed.mjs",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test server/**/*.test.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "@tailwindcss/vite": "^4.1.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {"concurrently": "^9.1.2", "vite": "^6.0.0"}
}
